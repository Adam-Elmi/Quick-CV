@_style_@;
  body { font-family: 'Helvetica', sans-serif; color: #333; line-height: 1.4; margin: 0; padding: 0; }
  p { margin: 0; padding: 0; }
  span:empty, div:empty { display: none; }
@_end_@
[div = textAlign: center, marginBottom: 15]
  [img = src: "p{picture}", alt: "Profile Picture",  style: "width: 80; height: 80; borderRadius: 10;"][end]
[end]
[div = textAlign: center]
  p{profile_title}
[end]
# Header Section
[div = textAlign: center, marginBottom: 20, borderBottom: "2px solid #333", paddingBottom: 15]
  [h1 = fontSize: 24, fontWeight: bold, textTransform: uppercase, margin: 0, color: "#1e293b"]
    p{First-Name} p{Last-Name}
  [end]
  [div = fontSize: 14, color: "#64748b", marginTop: 5, fontWeight: 500]
    p{Title}
  [end]
  [div = fontSize: 11, color: "#475569", marginTop: 8]
    p{Email} | p{Phone} | p{City} | p{Country}
  [end]
  # Social Links (Static 1-4)
  [div = display: flex, justifyContent: center, gap: 15, marginTop: 10, fontSize: 10, color: "#475569"]
    [span]
      p{link-1}
    [end]
    [span]
      p{link-2}
    [end]
    [span]
      p{link-3}
    [end]
    [span]
      p{link-4}
    [end]
  [end]
[end]
# Experience Section
[div = marginTop: 15]
  [h3 = borderBottom: "1px solid #ddd", paddingBottom: 5, marginBottom: 10, color: "#334155", fontSize: 14, fontWeight: bold, textTransform: uppercase]
    Experience
  [end]
  # Exp 1
  [div = marginBottom: 12]
    [div = display: flex, justifyContent: space-between, fontWeight: bold, fontSize: 12, color: "#1e293b"]
      [span]
        p{exp-1-position}
      [end]
      [span]
        p{exp-1-start} - p{exp-1-end}
      [end]
    [end]
    [div = fontSize: 12, fontStyle: italic, color: "#475569"]
      p{exp-1-company} | p{exp-1-city}
    [end]
    [div = fontSize: 11, marginTop: 4]
      p{exp-1-desc}
    [end]
  [end]
  # Exp 2
  [div = marginBottom: 12]
    [div = display: flex, justifyContent: space-between, fontWeight: bold, fontSize: 12, color: "#1e293b"]
      [span]
        p{exp-2-position}
      [end]
      [span]
        p{exp-2-start} - p{exp-2-end}
      [end]
    [end]
    [div = fontSize: 12, fontStyle: italic, color: "#475569"]
      p{exp-2-company} | p{exp-2-city}
    [end]
    [div = fontSize: 11, marginTop: 4]
      p{exp-2-desc}
    [end]
  [end]
[end]
# Education Section
[div = marginTop: 15]
  [h3 = borderBottom: "1px solid #ddd", paddingBottom: 5, marginBottom: 10, color: "#334155", fontSize: 14, fontWeight: bold, textTransform: uppercase]
    Education
  [end]
  # Edu 1
  [div = marginBottom: 10]
    [div = display: flex, justifyContent: space-between, fontWeight: bold, fontSize: 12, color: "#1e293b"]
      [span]
        p{edu-1-school}
      [end]
      [span]
        p{edu-1-start} - p{edu-1-end}
      [end]
    [end]
    [div = fontSize: 12, fontStyle: italic, color: "#475569"]
      p{edu-1-degree} | p{edu-1-city}
    [end]
  [end]
[end]
# Skills Section
[div = marginTop: 15]
  [h3 = borderBottom: "1px solid #ddd", paddingBottom: 5, marginBottom: 10, color: "#334155", fontSize: 14, fontWeight: bold, textTransform: uppercase]
    Skills
  [end]
  [div = display: flex, flexWrap: wrap, gap: 8]
    [span = backgroundColor: "#f1f5f9", padding: "2px 8px", borderRadius: 4, fontSize: 10]
      p{skill-1}
    [end]
    [span = backgroundColor: "#f1f5f9", padding: "2px 8px", borderRadius: 4, fontSize: 10]
      p{skill-2}
    [end]
    [span = backgroundColor: "#f1f5f9", padding: "2px 8px", borderRadius: 4, fontSize: 10]
      p{skill-3}
    [end]
    [span = backgroundColor: "#f1f5f9", padding: "2px 8px", borderRadius: 4, fontSize: 10]
      p{skill-4}
    [end]
    [span = backgroundColor: "#f1f5f9", padding: "2px 8px", borderRadius: 4, fontSize: 10]
      p{skill-5}
    [end]
    [span = backgroundColor: "#f1f5f9", padding: "2px 8px", borderRadius: 4, fontSize: 10]
      p{skill-6}
    [end]
  [end]
[end]
