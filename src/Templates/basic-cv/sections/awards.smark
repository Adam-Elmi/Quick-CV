# Awards Section
[div = marginTop: 15]
  [h3 = borderBottom: "1px solid #ddd", paddingBottom: 5, marginBottom: 10, color: "#334155", fontSize: 14, fontWeight: bold, textTransform: uppercase]
    p{awards_title}
  [end]
  # Award 1
  [div = marginBottom: 12]
    [div = display: flex, justifyContent: space-between, fontWeight: bold, fontSize: 12, color: "#1e293b"]
      [span]
        p{award-1-name}
      [end]
      [span]
        p{award-1-date}
      [end]
    [end]
    [div = fontSize: 12, fontStyle: italic, color: "#475569"]
      p{award-1-org}
    [end]
    [div = fontSize: 11, marginTop: 4, color: "#475569"]
      p{award-1-desc}
    [end]
  [end]
  # Award 2
  [div = marginBottom: 12]
    [div = display: flex, justifyContent: space-between, fontWeight: bold, fontSize: 12, color: "#1e293b"]
      [span]
        p{award-2-name}
      [end]
      [span]
        p{award-2-date}
      [end]
    [end]
    [div = fontSize: 12, fontStyle: italic, color: "#475569"]
      p{award-2-org}
    [end]
    [div = fontSize: 11, marginTop: 4, color: "#475569"]
      p{award-2-desc}
    [end]
  [end]
  # Award 3
  [div = marginBottom: 12]
    [div = display: flex, justifyContent: space-between, fontWeight: bold, fontSize: 12, color: "#1e293b"]
      [span]
        p{award-3-name}
      [end]
      [span]
        p{award-3-date}
      [end]
    [end]
    [div = fontSize: 12, fontStyle: italic, color: "#475569"]
      p{award-3-org}
    [end]
    [div = fontSize: 11, marginTop: 4, color: "#475569"]
      p{award-3-desc}
    [end]
  [end]
[end]
