# Skills Section
[div = marginTop: 15]
  [h3 = borderBottom: "1px solid #ddd", paddingBottom: 5, marginBottom: 10, color: "#334155", fontSize: 14, fontWeight: bold, textTransform: uppercase]
    p{skills_title}
  [end]
  [ul = display: flex, flexWrap: wrap, gap: 8, flexDirection: column]
    [li = padding: "2px 4px", borderRadius: 4, fontSize: 10]
      p{skill-1}
    [end]
    [li = padding: "2px 4px", borderRadius: 4, fontSize: 10]
      p{skill-2}
    [end]
    [li = padding: "2px 4px", borderRadius: 4, fontSize: 10]
      p{skill-3}
    [end]
    [li = padding: "2px 4px", borderRadius: 4, fontSize: 10]
      p{skill-4}
    [end]
    [li = padding: "2px 4px", borderRadius: 4, fontSize: 10]
      p{skill-5}
    [end]
    [li = padding: "2px 4px", borderRadius: 4, fontSize: 10]
      p{skill-6}
    [end]
  [end]
[end]
