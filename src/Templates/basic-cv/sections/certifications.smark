# Certifications Section
[div = marginTop: 15]
  [h3 = borderBottom: "1px solid #ddd", paddingBottom: 5, marginBottom: 10, color: "#334155", fontSize: 14, fontWeight: bold, textTransform: uppercase]
    p{certifications_title}
  [end]
  # Cert 1
  [div = marginBottom: 12]
    [div = display: flex, justifyContent: space-between, fontWeight: bold, fontSize: 12, color: "#1e293b"]
      [span]
        p{cert-1-name}
      [end]
      [span]
        p{cert-1-issue-date}
      [end]
    [end]
    [div = fontSize: 12, fontStyle: italic, color: "#475569"]
      p{cert-1-issuer}
    [end]
    [div = fontSize: 11, color: "#475569", marginTop: 2]
      p{cert-1-expiry-date}
    [end]
    [div = fontSize: 11, color: "#6366f1", marginTop: 2]
      p{cert-1-url}
    [end]
  [end]
  # Cert 2
  [div = marginBottom: 12]
    [div = display: flex, justifyContent: space-between, fontWeight: bold, fontSize: 12, color: "#1e293b"]
