[import = Profile: "./sections/profile.smark"][end]
[import = SocialLinks: "./sections/social_links.smark"][end]
[import = Experience: "./sections/experience.smark"][end]
[import = Education: "./sections/education.smark"][end]
[import = Skills: "./sections/skills.smark"][end]

# Style
@_style_@;
  body { font-family: 'Helvetica', sans-serif; color: #333; line-height: 1.4; margin: 0; padding: 0; }
  p { margin: 0; padding: 0; }
  span:empty, div:empty { display: none; }
@_end_@

# Section title & profile picture
[div = textAlign: center, marginBottom: 15]
  [img = src: p{picture}, alt: "Profile Picture", style: "width: 80px; height: 80px; borderRadius: 10px;"][end]
[end]
[div = textAlign: center]
  p{profile_title}
[end]

# Profile Section
[div = textAlign: center, marginBottom: 20, borderBottom: "2px solid #333", paddingBottom: 15]
  [$use-module = Profile][end]
  [$use-module = SocialLinks][end]
[end]

# Experience Section
[$use-module = Experience][end]
# Education Section
[$use-module = Education][end]
# Skills Section
[$use-module = Skills][end]