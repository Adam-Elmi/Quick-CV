    p{skills_title}
  [end]
  [div = fontSize: 10, lineHeight: 1.6]
    [div]
      p{skill-1}
    [end]
    [div]
      p{skill-2}
    [end]
    [div]
      p{skill-3}
    [end]
    [div]
      p{skill-4}
    [end]
    [div]
      p{skill-5}
    [end]
  [end]
[end]
