# Projects
[div = marginBottom: 25]
  [h2 = fontSize: 16, color: "#1e3a8a", borderBottom: "2px solid #1e3a8a", paddingBottom: 5, marginBottom: 15, fontWeight: bold]
    p{projects_title}
  [end]
  # Proj 1
  [div = marginBottom: 15]
    [div = fontWeight: bold, fontSize: 13, color: "#1e293b"]
      p{proj-1-name}
    [end]
    [div = fontSize: 11, color: "#1e40af", fontWeight: 600, marginBottom: 3]
      p{proj-1-tech}
    [end]
    [div = fontSize: 11, color: "#6366f1", marginBottom: 3]
      p{proj-1-link}
    [end]
    [div = fontSize: 11, color: "#475569"]
      p{proj-1-desc}
    [end]
  [end]
