# Certifications
[div = marginBottom: 25]
  [h2 = fontSize: 16, color: "#1e3a8a", borderBottom: "2px solid #1e3a8a", paddingBottom: 5, marginBottom: 15, fontWeight: bold]
    p{certifications_title}
  [end]
  # Cert 1
  [div = marginBottom: 15]
    [div = fontWeight: bold, fontSize: 13, color: "#1e293b"]
      p{cert-1-name}
    [end]
    [div = fontSize: 12, color: "#1e40af", fontWeight: 600, marginBottom: 3]
      p{cert-1-issuer}
    [end]
    [div = display: flex, fontSize: 11, color: "#64748b", marginBottom: 3]
      [span = marginRight: 12] p{cert-1-issue-date} [end]
      [span] p{cert-1-expiry-date} [end]
    [end]
    [div = fontSize: 11, color: "#475569"]
      p{cert-1-url}
    [end]
  [end]
  # Cert 2
  [div = marginBottom: 15]
    [div = fontWeight: bold, fontSize: 13, color: "#1e293b"]
